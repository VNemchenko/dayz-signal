# API keys must be at least 32 characters. Placeholder values intentionally fail closed.
SERVER1_NAME=dayz-eu-main
SERVER1_ID=livonia-1
SERVER1_BIND_HOST=127.0.0.1
SERVER1_HTTP_PORT=8081
SERVER1_STARTUP_TIMEOUT_MS=15000
SERVER1_SHUTDOWN_GRACE_MS=10000
SERVER1_API_KEY=replace_with_random_key_at_least_32_chars_server1
SERVER1_RCON_HOST=127.0.0.1
SERVER1_RCON_PORT=2305
SERVER1_RCON_PASSWORD=replace_with_real_rcon_password_server1
SERVER1_RCON_CONNECTION_TYPE=udp4
SERVER1_RCON_CONNECTION_TIMEOUT_MS=50000
SERVER1_RCON_CONNECTION_INTERVAL_MS=5000
SERVER1_RCON_KEEPALIVE_MS=10000
SERVER1_RCON_COMMAND_TIMEOUT_MS=7000
SERVER1_RCON_RECONNECT_BASE_MS=1000
SERVER1_RCON_RECONNECT_MAX_MS=30000
SERVER1_QUEUE_CAPACITY=50
SERVER1_BROADCAST_TTL_SECONDS=30
SERVER1_BROADCAST_MAX_TTL_SECONDS=300
SERVER1_COMMAND_MAX_FUTURE_SKEW_SECONDS=30
SERVER1_IDEMPOTENCY_RETENTION_MS=86400000
SERVER1_IDEMPOTENCY_MAX_RECORDS=10000
SERVER1_JOURNAL_MAX_BYTES=16777216
SERVER1_RATE_LIMIT_PER_MINUTE=30
SERVER1_RATE_LIMIT_BURST=5

